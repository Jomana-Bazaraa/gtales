# ---- Site ----
# Public URL of the deployment (no trailing slash). Leave empty locally; https://gtales.kids in production.
# NEXT_PUBLIC_* values are baked in at build time: on Cloudflare set them as BUILD variables too (docs/DEPLOY.md).
NEXT_PUBLIC_SITE_URL=
# Business WhatsApp number in international format without +, e.g. 2010xxxxxxxx (footer, "Message us")
NEXT_PUBLIC_WHATSAPP=

# ---- Pricing: the ONE place (EGP). List price per BOOK, launch % on every order (no code needed), delivery per ORDER ----
NEXT_PUBLIC_LIST_PRICE_EGP=249
NEXT_PUBLIC_PROMO_CODE=LAUNCH40
NEXT_PUBLIC_PROMO_PERCENT=40
NEXT_PUBLIC_DELIVERY_EGP=89

# ---- Free story AI polish (SPEC §7.4). off = plain fillStory, always works ----
POLISH_PROVIDER=off
POLISH_MODEL=
POLISH_TEMPERATURE=0.25
ANTHROPIC_API_KEY=

# ---- Gemini (internal studio only; the free story never generates images) ----
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# cover = 1 colour cover + line-art twin (2 image calls, ~$0.07/story)
# full  = cover + every story page coloured (~12 calls, ~$0.41/story)
# mixed = cover + pages alternating colour / line-art (~12 calls, ~$0.41/story)
ILLUSTRATION_MODE=cover

# ---- Supabase (leave empty = local JSON store in .data/ and files in public/generated/) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (leave empty = emails written to .data/outbox/) ----
RESEND_API_KEY=
EMAIL_FROM="GTales <stories@gtales.kids>"
ADMIN_NOTIFY_EMAIL=

# ---- Reviews: Cloudflare Turnstile (Cloudflare dashboard → Turnstile → Add widget, domain gtales.kids) ----
# Site key is public and baked in at build (Cloudflare BUILD variable too); the secret is a runtime Secret. Empty = no bot check (dev only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Admin ----
ADMIN_PASSWORD=change-me
# random string; only the PDF renderer may open /story/[id]/print (same value in the GitHub repo secrets)
INTERNAL_RENDER_TOKEN=change-me-too

# ---- PDFs (rendered by the GitHub Action .github/workflows/pdf.yml, never on the web server) ----
# Fine-grained GitHub token: only this repo, permission "Actions: Read and write". Empty = jobs stay queued (npm run pdf:jobs).
GITHUB_PDF_TOKEN=
GITHUB_PDF_REPO=Jomana-Bazaraa/gtales
GITHUB_PDF_REF=main
# Local scripts only (npm run pdf:jobs / pdfs / samples): path to Chrome/Chromium
PUPPETEER_EXECUTABLE_PATH=
# Set to 1 to skip PDF generation in the local scripts
PDF_DISABLED=

# ---- Abuse ----
RATE_LIMIT_PER_HOUR=10

# ---- "What's inside every book" box on the homepage + order page (1 = show; build variable) ----
NEXT_PUBLIC_SHOW_WHATS_INSIDE=

# ---- Story PDFs for parents (hidden 29 Oct). Only "true" re-opens /api/books/<id>/pdf and /story/<id>/pdf; admin always can ----
PDF_ENABLED=false
