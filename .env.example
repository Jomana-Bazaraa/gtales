# ---- Site ----
# Public URL of the deployment (no trailing slash). Leave empty locally; set on Vercel to your domain.
NEXT_PUBLIC_SITE_URL=
# Business WhatsApp number in international format without +, e.g. 2010xxxxxxxx (footer, "Message us")
NEXT_PUBLIC_WHATSAPP=

# ---- Pricing (defaults until Admin → Settings exists; EGP) ----
NEXT_PUBLIC_LIST_PRICE_EGP=949
NEXT_PUBLIC_PROMO_CODE=LAUNCH40
NEXT_PUBLIC_PROMO_PERCENT=40
NEXT_PUBLIC_DELIVERY_EGP=69
# Reviews section stays hidden until three real reviews exist
NEXT_PUBLIC_REVIEWS_VISIBLE=false

# ---- Free story AI polish (SPEC §7.4). off = plain fillStory, always works ----
POLISH_PROVIDER=off
POLISH_MODEL=
POLISH_TEMPERATURE=0.25
ANTHROPIC_API_KEY=

# ---- Gemini (internal studio only; the free story never generates images) ----
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# cover = 1 colour cover + line-art twin (2 image calls, ~$0.07/story)
# full  = cover + every story page coloured (~12 calls, ~$0.41/story)
# mixed = cover + pages alternating colour / line-art (~12 calls, ~$0.41/story)
ILLUSTRATION_MODE=cover

# ---- Supabase (leave empty = local JSON store in .data/ and files in public/generated/) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (leave empty = emails written to .data/outbox/) ----
RESEND_API_KEY=
EMAIL_FROM="GTales <stories@gtales.app>"
ADMIN_NOTIFY_EMAIL=

# ---- Admin ----
ADMIN_PASSWORD=change-me
# random string; protects the internal PDF/finalize routes
INTERNAL_RENDER_TOKEN=change-me-too

# ---- PDFs ----
# Local dev: path to a Chrome/Chromium binary. On Vercel this is ignored (@sparticuz/chromium is used).
PUPPETEER_EXECUTABLE_PATH=
# Set to 1 to skip PDF generation entirely (dev without Chrome)
PDF_DISABLED=

# ---- Abuse ----
RATE_LIMIT_PER_HOUR=10
