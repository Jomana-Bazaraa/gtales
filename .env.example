# ---- Site ----
# Public URL of the deployment (no trailing slash). Leave empty locally; set on Vercel to your domain.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BOOK_PRICE_EGP=450

# ---- Gemini (leave empty = mock mode: placeholder text + SVG images) ----
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# cover = 1 colour cover + line-art twin (2 image calls, ~$0.07/story)
# full  = cover + every story page coloured (~12 calls, ~$0.41/story)
# mixed = cover + pages alternating colour / line-art (~12 calls, ~$0.41/story)
ILLUSTRATION_MODE=cover

# ---- Supabase (leave empty = local JSON store in .data/ and files in public/generated/) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (leave empty = emails written to .data/outbox/) ----
RESEND_API_KEY=
EMAIL_FROM="Estoria <stories@estoria.kids>"
ADMIN_NOTIFY_EMAIL=

# ---- Admin ----
ADMIN_PASSWORD=change-me
# random string; protects the internal PDF/finalize routes
INTERNAL_RENDER_TOKEN=change-me-too

# ---- PDFs ----
# Local dev: path to a Chrome/Chromium binary. On Vercel this is ignored (@sparticuz/chromium is used).
PUPPETEER_EXECUTABLE_PATH=
# Set to 1 to skip PDF generation entirely (dev without Chrome)
PDF_DISABLED=

# ---- Abuse ----
RATE_LIMIT_PER_HOUR=5
